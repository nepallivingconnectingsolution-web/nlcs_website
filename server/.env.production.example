# Copy to `server/.env` on the VPS and fill in the blanks.
# This mirrors server/.env.example, with the values that must change for production.

# ---- Server ----
NODE_ENV=production
PORT=5000
# Frontend origin(s) allowed by CORS — comma-separated if there's more than one.
CLIENT_URL=https://nlcsitservice.com

# ---- Database ----
# MongoDB runs on this same VPS, so localhost is correct — no change needed
# as long as this file is the one deployed to the VPS (not the local dev copy).
MONGO_URI=mongodb://localhost:27017/nlcs_db

# ---- Auth (admin) ----
# Generate a fresh one for production, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Seed super admin (used by `npm run seed` — run once on first deploy)
ADMIN_NAME=NLCS Super Admin
ADMIN_EMAIL=admin@nlcsitservice.com
ADMIN_PASSWORD=

# ---- Email (contact notifications via SMTP) ----
# Leave SMTP_HOST empty to disable email sending (contacts are still saved to DB).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NLCS Website <no-reply@nlcsitservice.com>
MAIL_TO=info@nlcsitservice.com
