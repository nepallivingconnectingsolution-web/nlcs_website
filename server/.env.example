# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/nlcs

# ---- Auth (admin) ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed super admin (used by `npm run seed`) — controls everything
ADMIN_NAME=NLCS Super Admin
ADMIN_EMAIL=admin@nlcsitservice.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Email (contact notifications via SMTP) ----
# Leave SMTP_HOST empty to disable email sending (contacts are still saved to DB).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NLCS Website <no-reply@nlcsitservice.com>
MAIL_TO=info@nlcsitservice.com
